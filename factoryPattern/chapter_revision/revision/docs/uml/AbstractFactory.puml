@startuml
left to right direction
Interface AbstractFactory {
    createProductA(): InterfaceProductA <<abstract>>
    createProductB(): InterfaceProductB <<abstract>>
    createProductC(): InterfaceProductC <<abstract>>
    createProductD(): InterfaceProductD <<abstract>>
    createProductE(): InterfaceProductE <<abstract>>
}

class ConcreteFactory1 {
    createProductA(): InterfaceProductA
    createProductB(): InterfaceProductB
    createProductC(): InterfaceProductC
    createProductD(): InterfaceProductD
    createProductE(): InterfaceProductE
}

class ConcreteFactory2 {
    createProductA(): InterfaceProductA
    createProductB(): InterfaceProductB
    createProductC(): InterfaceProductC
    createProductD(): InterfaceProductD
    createProductE(): InterfaceProductE
}

AbstractFactory <|.. ConcreteFactory1
AbstractFactory <|.. ConcreteFactory2

class Client {
}
Client --> AbstractFactory
interface InterfaceProductA {}
InterfaceProductA <|.. productA1
InterfaceProductA <|.. productA2

interface InterfaceProductB {}
InterfaceProductB <|.. productB1
InterfaceProductB <|.. productB2

interface InterfaceProductC {}
