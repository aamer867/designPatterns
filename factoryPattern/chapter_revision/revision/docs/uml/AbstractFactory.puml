InterfaceProductD <|.. productD2

interface InterfaceProductE {}
InterfaceProductE <|.. productE1
InterfaceProductE <|.. productE2

Client -->> InterfaceProductA
Client -->> InterfaceProductB
Client -->> InterfaceProductC
